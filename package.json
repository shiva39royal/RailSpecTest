{
  "name": "x-tractor",
  "productName": "X-Tractor",
  "version": "1.0.0",
  "description": "Indian Railways RDSO KAVACH Table of Control Automated Studio",
  "author": "RailSpec KAVACH Studio",
  "main": "Electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-server/server.mjs --external:vite --external:fsevents --external:esbuild --external:libredwg-web",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-server dist-installer",
    "lint": "tsc --noEmit",
    "electron:start": "electron Electron/main.cjs",
    "electron:build": "npm run build && npm run build:server && electron-builder --config Electron/electron-builder.json"
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.9.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "dxf-parser": "^1.1.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
