{
  "appId": "com.railspec.xtractor",
  "productName": "X-tractor",
  "copyright": "Copyright © 2026 RailSpec KAVACH TOC Studio",
  "directories": {
    "output": "dist-installer"
  },
  "asar": true,
  "asarUnpack": [
    "server/**/*",
    "Electron/assets/**/*"
  ],
  "files": [
    "dist/**/*",
    "dist-server/**/*",
    "server/**/*",
    "public/**/*",
    "data/**/*",
    "!data/projects/*.json",
    "!data/uploads/*.pdf",
    "Electron/main.cjs",
    "Electron/preload.cjs",
    "Electron/assets/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dist-server",
      "to": "dist-server",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/@mlightcad/libredwg-web/wasm",
      "to": "libredwg-wasm",
      "filter": ["**/*"]
    },
    {
      "from": "server",
      "to": "server",
      "filter": ["**/*"]
    },
    {
      "from": "public",
      "to": "public",
      "filter": ["**/*"]
    },
    {
      "from": "data",
      "to": "data",
      "filter": ["**/*", "!projects/*.json", "!uploads/*.pdf"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "Electron/assets/icon.ico",
    "executableName": "X-tractor"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "X-tractor",
    "artifactName": "X-tractor Setup ${version}.${ext}",
    "installerIcon": "Electron/assets/icon.ico",
    "uninstallerIcon": "Electron/assets/icon.ico",
    "installerHeaderIcon": "Electron/assets/icon.ico",
    "runAfterFinish": true
  }
}
